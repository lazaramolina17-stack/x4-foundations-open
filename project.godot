[application]
config/name="X4-Like Space Empire"
config/icon="res://icon.png"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.3", "forward_plus")

[rendering]
environment/defaults/default_environment="res://assets/environments/default_env.tres"
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=4
anti_aliasing/quality/msaa_2d=2

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="2d"
window/stretch/aspect="keep"
window/dpi/allow_hidpi=true

[input]
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":65,"keycode":65), Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":37,"keycode":37)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":68,"keycode":68), Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":39,"keycode":39)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":87,"keycode":87), Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":38,"keycode":38)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":83,"keycode":83), Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":40,"keycode":40)]
}
fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":true,"resource_name":"","button_index":1), Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":32)]
}
boost={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":16)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":70)]
}
target_ahead={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":84)]
}
cycle_target={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":82)]
}
toggle_map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":77)]
}
travel_mode={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":16777218)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":true,"resource_name":"","physical_keycode":112)]
}

[autoload]
GameManager="*res://scripts/core/game_manager.gd"
UniverseManager="*res://scripts/core/universe_manager.gd"
EconomyManager="*res://scripts/economy/economy_manager.gd"
FactionManager="*res://scripts/factions/faction_manager.gd"
TimeManager
MissionManager="*res://scripts/ui/mission_manager.gd"="*res://scripts/core/time_manager.gd"

[physics]
common/physics_ticks_per_second=120

[layer_names]
3d_layer_1="ships"
3d_layer_2="stations"
3d_layer_3="projectiles"
3d_layer_4="gates"
3d_layer_5="debris"
